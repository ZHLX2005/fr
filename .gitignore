# Miscellaneous

.worktrees/
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Generated API (use lib/generated instead)
generated_api/
api_spec.json

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Test files (local API testing - never commit)
test/*
# Exception: localnet framework test infrastructure is version-controlled
!test/core/
!test/core/localnet/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated chart files (need manual adjustment) - but committed charts are in git
# assets/charts/*.json
PROJECT_INDEX.json
PROJECT_INDEX.md

# Cloned repositories (nested git repos)
# 父目录用 /* 而非 /,这样 _read 否定规则才能生效
.claude/repo/*
!.claude/repo/_read/
!.claude/repo/_read/**
!.claude/repo/_self/
!.claude/repo/_self/**
.omc/
.claude/logs/


test
.tool

# 本地临时目录（截图 / MCP 调试产物 / null 输出等）
.tmp/
nul

# Flutter Web deploy context (CI-generated by deploy-web.yml)
web_deploy/build-web/
