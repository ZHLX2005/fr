<?xml version="1.0" encoding="utf-8"?>
<!-- 三段 vertical 布局：刷新图标(顶) / 内容(中, weight=1) / toggle 按钮(底带)。
     原来用 FrameLayout 把按钮压在内容上 → 图标/文字重叠；改三段后按钮有专属底带，
     且按钮带圆形背景(widget_btn_circle)，可视化点击范围。minHeight 提到 150dp 容纳。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <!-- 顶部：刷新图标，右对齐，独占一行（不与时间文字重叠） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_margin="8dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_paused"
            android:contentDescription="刷新时钟" />
    </FrameLayout>

    <!-- 中部：标题 / 时间 / 状态 pill，weight=1 居中 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无倒计时"
            android:textSize="13sp"
            android:textColor="#5F6368"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 时间显示：静态 TextView 与自走字 Chronometer 二选一（visibility 切换）。
             - Chronometer（运行中）：由桌面 host 进程自己每秒刷新，app 侧零唤醒。
               数到 0 不自停，越过 0 后框架会套 R.string.negative_duration 自动加负号。
             - TextView（暂停/等待开始/无时钟）：走 Kotlin 侧 formatHms()，保留
               完整的 [-]HH:MM:SS 补零格式。
             两者样式逐项对齐 + layout_gravity=center，避免切换时宽度变化导致跳位。 -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="00:00:00"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:fontFamily="monospace" />

            <Chronometer
                android:id="@+id/widget_time_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:fontFamily="monospace"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 状态 pill：浅 tint 底 + 同色描边 + 同色字（背景/字色随状态由 Kotlin 切换） -->
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="进行中"
            android:textSize="11sp"
            android:textColor="#4CAF50"
            android:background="@drawable/status_pill_running"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- 底部：toggle 按钮底带（圆形背景 = 可视点击范围），居中 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:paddingTop="4dp">
        <ImageButton
            android:id="@+id/widget_toggle_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:background="@drawable/widget_btn_circle"
            android:src="@drawable/widget_ic_play"
            android:contentDescription="开始/暂停时钟" />
    </FrameLayout>

</LinearLayout>
